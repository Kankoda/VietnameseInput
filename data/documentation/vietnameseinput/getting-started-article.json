{"identifier":{"url":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Getting-Started-Article","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput"]]},"metadata":{"modules":[{"name":"VietnameseInput"}],"roleHeading":"Article","title":"Getting Started","role":"article"},"primaryContentSections":[{"content":[{"text":"Setting up the SDK","level":2,"anchor":"Setting-up-the-SDK","type":"heading"},{"inlineContent":[{"type":"text","text":"This SDK requires a "},{"type":"reference","isActive":true,"identifier":"https:\/\/kankoda.com\/vietnameseinput"},{"type":"text","text":" to be used. You can sign up for a license from the "},{"type":"reference","identifier":"https:\/\/kankoda.com\/vietnameseinput","isActive":true,"overridingTitle":"product website","overridingTitleInlineContent":[{"text":"product website","type":"text"}]},{"type":"text","text":" or "},{"identifier":"https:\/\/kankoda.gumroad.com","type":"reference","isActive":true},{"type":"text","text":", then use either the "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicense\/register(withLicenseKey:)","isActive":true},{"text":" or ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicense\/register(withLicenseFileIn:)","isActive":true},{"type":"text","text":" function to unlock the SDK:"}],"type":"paragraph"},{"code":["\/\/ If you have a license key","let license = try await VietnameseInputLicense.register(withLicenseKey: \"your-license-key\")","","\/\/ If you have a license file","let license = try await VietnameseInputLicense.register(withLicenseFileIn: .module)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The functions will return your license or throw an error. You can use this license or the global "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicense\/current","isActive":true},{"type":"text","text":" license to inspect your license."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To register a license in a SwiftUI app, the "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicenseView","isActive":true},{"type":"text","text":" will register a license before rendering its content view."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"You can use the “FREE” license key to set up the library with a capped license that can make 50 requests before it stops working.","type":"text"}]}],"name":"Tip","style":"tip"},{"type":"heading","text":"Namespaces","anchor":"Namespaces","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This library has a "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese","isActive":true},{"type":"text","text":" namespace with language-related models like "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/Diacritic","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod","isActive":true},{"type":"text","text":", and a "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput","isActive":true},{"type":"text","text":" namespace with library- and license-related models."}]},{"type":"heading","text":"Vietnamese Input Engine","anchor":"Vietnamese-Input-Engine","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputEngine","isActive":true},{"type":"text","text":" type can be used for Vietnamese input. To use it, create an instance after registering your license:"}]},{"type":"codeListing","code":["let engine = try VietnameseInputEngine()        \/\/ Fails if no license is registered"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This engine supports both "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod\/telex","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod\/viqr","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod\/vni","isActive":true},{"type":"text","text":". You can see "},{"type":"reference","identifier":"https:\/\/vntyping.com","isActive":true},{"type":"text","text":" for more information on how these "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod","isActive":true},{"type":"text","text":"s work."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the engine in place, you can use "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputEngine\/input(_:into:with:)","isActive":true},{"type":"text","text":" to simulate typing a sequence of characters into a text."}]},{"type":"codeListing","code":["\/\/ TELEX","engine.input(\"uow\", into: \"\", with: .telex)     \/\/ -> \"ươ\"","engine.input(\"ow\", into: \"u\", with: .telex)     \/\/ -> \"ươ\"","engine.input(\"Duowng\", into: \"\", with: .telex)  \/\/ -> \"Dương\"","","\/\/ VIQR","engine.input(\"uo*\",in to: \"\", with: .viqr)      \/\/ -> \"ươ\"","engine.input(\"o*\",in to: \"u\", with: .viqr)      \/\/ -> \"ươ\"","engine.input(\"Duo*ng\"in, to: \"\", with: .viqr)   \/\/ -> \"Dương\"","","\/\/ VNI","engine.input(\"uo7\", into: \"\", with: .vni)       \/\/ -> \"ươ\"","engine.input(\"o7\", into: \"u\", with: .vni)       \/\/ -> \"ươ\"","engine.input(\"Duo7ng\", into: \"\", with: .vni)    \/\/ -> \"Dương\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use the "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputEngine\/diacriticReplacement(whenInputting:into:with:)","isActive":true},{"type":"text","text":" function to see if an input character should be replaced with a diacritic, and if so how."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/vietnameseinput\/getting-started-article"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"This guide describes how to get started with VietnameseInput.","type":"text"}],"references":{"doc://src.VietnameseInput/documentation/VietnameseInput/Vietnamese/InputMethod/viqr":{"abstract":[{"type":"text","text":"VIQR repurposes some punctuation mark characters"},{"type":"text","text":" "},{"type":"text","text":"to apply diacritics."}],"identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod\/viqr","kind":"symbol","url":"\/documentation\/vietnameseinput\/vietnamese\/inputmethod\/viqr","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"viqr","kind":"identifier"}],"title":"Vietnamese.InputMethod.viqr","role":"symbol","type":"topic"},"doc://src.VietnameseInput/documentation/VietnameseInput/Vietnamese/InputMethod/vni":{"abstract":[{"type":"text","text":"VNI repurposes some number & function characters"},{"type":"text","text":" "},{"type":"text","text":"to apply diacritics."}],"identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Vietnamese\/InputMethod\/vni","kind":"symbol","url":"\/documentation\/vietnameseinput\/vietnamese\/inputmethod\/vni","fragments":[{"kind":"keyword","text"