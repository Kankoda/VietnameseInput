{"abstract":[{"type":"text","text":"This guide describes how to get started with VietnameseInput."}],"kind":"article","metadata":{"modules":[{"name":"VietnameseInput"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"VietnameseInput has a "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputEngine","isActive":true},{"type":"text","text":" that lets you type in TELEX, VNI, and VIQR."}]},{"level":2,"anchor":"License-Registration","type":"heading","text":"License Registration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This package requires a "},{"type":"reference","identifier":"https:\/\/kankoda.com\/vietnameseinput","isActive":true},{"type":"text","text":" to be used. You can sign up for a free or paid license from the "},{"type":"reference","identifier":"https:\/\/kankoda.com\/vietnameseinput","isActive":true,"overridingTitleInlineContent":[{"text":"website","type":"text"}],"overridingTitle":"website"},{"type":"text","text":", then either call "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicense","isActive":true},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"register(...)"},{"type":"text","text":" function or apply an "},{"type":"reference","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicenseModifier","isActive":true},{"type":"text","text":" to your app’s root view:"}]},{"code":["try await OnboardingKitLicense.register(.gumroad(licenseKey: \"...\"))"],"type":"codeListing","syntax":"swift"},{"code":["@main","struct MyApp: App {","","    var body: some Scene {","        WindowGroup {","            ContentView()   \/\/ <- Your app's main content view","                .vie