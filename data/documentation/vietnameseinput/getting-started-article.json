":"reference","isActive":true,"identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputEngine\/diacriticReplacement(whenInputting:into:with:)"},{"text":" function to see if an input character should be replaced with a diacritic, and if so how.","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput"]]},"variants":[{"paths":["\/documentation\/vietnameseinput\/getting-started-article"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/Getting-Started-Article"},"sections":[],"references":{"doc://src.VietnameseInput/documentation/VietnameseInput/VietnameseInputLicense":{"type":"topic","abstract":[{"type":"text","text":"This type represents a license you use to unlock the SDK."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VietnameseInputLicense"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"VietnameseInputLicense"}],"url":"\/documentation\/vietnameseinput\/vietnameseinputlicense","identifier":"doc:\/\/src.VietnameseInput\/documentation\/VietnameseInput\/VietnameseInputLicense","title":"VietnameseInputLicense"},"doc://src.VietnameseInput/documentation/VietnameseInput/VietnameseInputLicenseModifier":{"type":"topic","abstract":[{"type":"text","text":"This view modifier can be applied to the root view of an"},{"type":"text","text":" "},{"type":"text","text":"app, and will register your license before rendering the"},{"type":"text","text":" "},{"type":"text","text":"modified content view."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VietnameseInputLicenseModifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VietnameseInputLicenseModifier"}],"url":"\/doc